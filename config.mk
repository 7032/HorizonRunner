# ============================================================
# config.mk — HorizonRunner プロジェクト設定 (= 唯一の設定ファイル)
#
# ここの値だけ書き換えれば、Makefile / link.script / asm_ipl.s
# の参照は全部追従する。直接 lwasm を叩く時は make が渡している
# -D BODY_LOAD=$(ORG) を自分で与えること。
# ============================================================

# 生成物のファイル名 (build/<NAME>.bin / build/<NAME>.d77 / D77 ラベル)
NAME = horizonrunner

# 本体プログラム (crt0 + main) の開始アドレス
#   = Makefile の本体リンクアドレス
#   = link.script の `section code load` アドレス
#   = asm_ipl.s の BODY_LOAD (IPL が本体を展開する先 + JMP 先)
# 既定 $0400 は、ブート ROM が IPL を置く $0100 (BASIC 標準) /
# $0300 (DOS) の 256byte 域を両方避けた安全な最小アドレス。
# ページ境界 ($xx00) に揃えること。
ORG  = 0x0400

# ============================================================
# サブ CPU 側メモリマップ (= 唯一の正)
#
# ここに書いた値と src/asm_subprog.s の equ / src/c_subprog.h の #define
# が食い違っていないかを、make のたびに scripts/check_layout.py が検査
# する。**片方だけ直すと転送先と参照先が静かにずれる**ため、目視に
# 頼らない。さらに同スクリプトは build/subprog.bin の実測サイズを検査し、
# SUB_PROG_ADDR + size が SUB_CODE_END を超えたらビルドを失敗させる
# (超えるとサブ CPU のスタックを踏んで暴走する。lwasm も lwlink も
#  エラーを出さないので機械で止める)。
#
# ------------------------------------------------------------
# 描画は B プレーン ($0000-$3E7F) のみ (= モノクロ 1 プレーン)
# ------------------------------------------------------------
# パレット $FD38-$FD3F を $00,$07,$00,$07,$00,$07,$00,$07 と置き、
# 「色番号 bit0 (= B プレーン) だけが白黒を決める」状態にする。
# 偶数色番号 = 黒 / 奇数色番号 = 白。R プレーン ($4000-$7FFF) と
# G プレーン ($8000-$BFFF) は表示に一切関与しないので、起動時の
# クリアは不要。計 32 KB を **バルクデータ専用の RAM** として使う
# (スプライト原本の置場は SUB_SPRITE_ADDR = R プレーン $4000 から)。
#
# 守るべき前提 (破ると静かに、あるいは派手に壊れる):
#   * R/G を読み書きする時は必ず VRAM ゲート ($D409) を開けておくこと。
#     閉じたまま読むと $FF かゴミが返る。
#   * $FD37 の bit0-2 は絶対に立てない ($FD37 は $00 のまま触らない)。
#   * 表示オフセットレジスタ $D40E/$D40F は常に 0 (1 度でも書くと
#     R/G の全アドレスがずれる)。
#   * R/G にコードを置かない (命令フェッチもゲート開が要り、全処理が
#     3.125 倍遅くなる)。
#   * 毎フレーム読み書きするテーブルを R/G に置かない。R/G は
#     「起動時に 1 回書き、以後読むだけ」のバルクデータ専用。
# ============================================================

# ---- サブ CPU 側 コンソール RAM ($C000-$CFFF) ----
# テーブルはコードより下位に置く。コードは SUB_PROG_ADDR から上へ
# 伸びるので、下に置いたテーブルにはコードの成長が到達し得ない。
SUB_WORK_ADDR   = 0xC000   # 作業変数 (32 byte 枠)
SUB_TABLE_ADDR  = 0xC020   # 面ごとの消し込み表 (2 面 x 26 件 x 4 byte = 208 byte)
SUB_PROG_ADDR   = 0xC100   # サブ側描画プログラム本体の入口 (+ 絵と模様表)
SUB_CODE_END    = 0xCF80   # コードはここ未満まで (= スタック予約の下端)
SUB_STACK_ADDR  = 0xCF80   # サブ CPU ハードウェアスタック 128 byte (潰さない)
                           #   SP 初期値 $D000 から下へ伸びる。NMI 12 byte +
                           #   入れ子の lbsr を受けるため 128 byte 確保。

# ---- サブ CPU 側 R プレーン (= 表示に使わない RAM) ----
SUB_SPRITE_ADDR = 0x4000   # スプライト原本の置場 (R プレーン先頭から)

# ---- VRAM 各面の末尾 (= 表示されない 384 byte x 3 面) ----
# 各面は 16 KB あるが表示に使うのは 200 line x 80 byte = 16,000 byte
# ($0000-$3E7F) だけで、末尾 $3E80-$3FFF の 384 byte は画面に出ない。
# サブ側のコード枠 ($C100-$CF7F) が絵で埋まったので、爆発の絵はここに
# 置く (起動時に $0A WRITE 命令で書き込む。scripts/make_sprite.py が
# 各面の枠に収まるよう割り付ける)。読む時は VRAM ゲートを開けておくこと。
SUB_TAIL0_ADDR  = 0x3E80   # B 面の末尾
SUB_TAIL1_ADDR  = 0x7E80   # R 面の末尾
SUB_TAIL2_ADDR  = 0xBE80   # G 面の末尾
SUB_TAIL_SIZE   = 0x0180   # 各 384 byte

# ============================================================
# テープ (CMT) 多段ロード側のメモリマップ
#
# scripts/d77_to_t77_chunks.py / scripts/trampoline.asm の定数と対で
# 使う (先行プロジェクトから値ごと移植。片方だけ変えないこと)。
# 既定ビルドには入っておらず、`make t77` を叩いた時だけ使われる。
# ============================================================

TAPE_STAGER_ADDR = 0x1400  # LOADM ブロックの先頭 (= Stage 1 の実行アドレス)
TAPE_BUFFER_ADDR = 0x2000  # ロードバッファの先頭
TAPE_CHUNK_SIZE  = 0x4000  # 塊の大きさ (= バッファの大きさ、16 KiB)
TAPE_TRAMP_ADDR  = 0xD000  # Stage 2 + 移動表の実行アドレス (裏 RAM)
TAPE_TRAMP_SIZE  = 0x0200  # そのための確保枠 (超えたら変換を失敗させる)
TAPE_STASH_LO    = 0x8000  # 裏 RAM の退避プール 下端
TAPE_STASH_HI    = 0xF000  # 裏 RAM の退避プール 上端 (これ未満まで使う)
TAPE_STACK_TOP   = 0xFBFF  # 最終パスが張り直すスタックの底
